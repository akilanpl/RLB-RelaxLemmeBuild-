# Application Environment Configuration Example
PROJECT_NAME="Cloud AI Software Engineering Workspace"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (Supabase PostgreSQL)
# Example: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=""

# Supabase API Settings
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_QUEUE_NAME="task_execution"
SUPABASE_STORAGE_BUCKET="workspace-artifacts"
# JWT verification uses https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# and accepts the "authenticated" audience by default.
SUPABASE_JWT_ISSUER=""
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWKS_CACHE_TTL_SECONDS=3600

# Planner provider (backend only)
GROQ_API_KEY=""
GROQ_MODEL=""

# Credential Encryption (32-byte key)
CREDENTIAL_ENCRYPTION_KEY=""

# Daytona sandbox (backend/worker only)
DAYTONA_API_URL=""
DAYTONA_API_KEY=""

# Separate cloud worker in production; embedded worker in development by default.
# RUN_EMBEDDED_WORKER=false
WORKER_POLL_SECONDS=1
# Worker only: container image with Node/Python and the supported build tools.
DAYTONA_SANDBOX_IMAGE=""
DAYTONA_TARGET=""

SANDBOX_ALLOWED_DOMAINS=["registry.npmjs.org","pypi.org","files.pythonhosted.org"]
MAX_AI_CALLS_PER_TASK=20
MAX_AI_OUTPUT_TOKENS=8192
# Persisted task controls (hosted migration 003 required)
MAX_REPAIR_ATTEMPTS=3
MAX_TASKS_PER_USER_PER_HOUR=30
