{
  "name": "rlb-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check frontend-entry.js && node --check build.js && node --test tests/*.test.js",
    "build:all": "node build.js",
    "dist": "node build.js --windows-installer && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.rlb.desktop",
    "productName": "RLB",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "tray.png"
    ],
    "extraResources": [
      {
        "from": "../frontend/.next/standalone",
        "to": "frontend/standalone"
      },
      {
        "from": "../frontend/.next/static",
        "to": "frontend/standalone/.next/static"
      },
      {
        "from": "../dist/rlb-runtime",
        "to": "backend"
      },
      {
        "from": "frontend-entry.js",
        "to": "frontend-entry.js"
      },
      {
        "from": "../frontend/.next/standalone/node_modules",
        "to": "frontend/standalone/node_modules"
      },
      {
        "from": "../frontend/public",
        "to": "frontend/standalone/public"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "RLB-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "../dist/toolchains",
          "to": "toolchains"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RLB",
      "include": "installer.nsh"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "description": "RLB \u2014 build on your machine, control from anywhere.",
  "overrides": {
    "http-cache-semantics": "^4.3.0"
  }
}
